# このファイルを「.env」という名前でコピーし、実際の値を記入してください。
# .env は .gitignore 済み（コミットされません）。このexampleに実際の値を書かないこと。

# Notion読み取り用トークン（konpie-bot の KOTOHIRA_NOTION_TOKEN の値を流用可）
KOTOHIRA_DASHBOARD_NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxx

# DB IDを既定値から変えたい場合のみ設定（通常は不要）
# NEWS_NOTION_DB_ID=
# KOTOHIRA_DATABASE_ID=
# CAMPAIGN_NOTION_DB_ID=
